{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clausid",
  "main": "apps/worker/src/cloudflare.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "build": { "command": "node scripts/build-pdf-engine.mjs" },
  "rules": [
    { "type": "Data", "globs": ["**/*.woff"], "fallthrough": true },
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }
  ],
  "durable_objects": {
    "code_update_strategy": { "mode": "immediate" },
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "CONTRACTS", "class_name": "Contract" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Directory", "Contract"] }],
  "d1_databases": [{
    "binding": "AUTH_DB",
    "database_name": "clausid-auth",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "deploy/d1"
  }],
  "send_email": [{ "name": "EMAIL" }],
  "vars": { "PUBLIC_ORIGIN": "", "MAIL_FROM": "" }
}
