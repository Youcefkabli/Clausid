{
  "name": "clausid",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r run build",
    "check": "tsc -b && vp lint",
    "check:docs": "node scripts/checks/docs.mts",
    "check:changed": "node scripts/checks/run.mts changed",
    "hooks:install": "node scripts/agent/install.mts",
    "hooks:status": "node scripts/agent/install.mts --status",
    "hooks:smoke:claude": "node scripts/agent/smokeClaude.mts",
    "postinstall": "node scripts/agent/install.mts --if-available",
    "verify": "node scripts/checks/run.mts app",
    "verify:pdf": "node scripts/checks/run.mts pdf",
    "verify:ops": "node scripts/checks/run.mts ops",
    "verify:all": "node scripts/checks/run.mts all",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "deploy": "node scripts/cloudflare-deploy.mjs",
    "check:policy": "node scripts/checks/policy.mts",
    "format:check": "node scripts/checks/format.mts check",
    "format": "node scripts/checks/format.mts write",
    "check:local": "node scripts/checks/run.mts local"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "fflate": "0.8.3",
    "typescript": "5.9.3",
    "vite-plus": "1.6.0",
    "wrangler": "4.162.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "packageManager": "pnpm@10.33.0",
  "cloudflare": {
    "bindings": {
      "PUBLIC_ORIGIN": {
        "description": "The exact public HTTPS origin for Clausid, without a trailing slash."
      },
      "MAIL_FROM": {
        "description": "A sender address on a domain onboarded to Cloudflare Email Service."
      },
      "BETTER_AUTH_SECRET": {
        "description": "A persistent random secret of at least 32 bytes."
      }
    }
  }
}
