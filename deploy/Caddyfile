# Example for a Caddy process on the VPS host.
{$PUBLIC_HOST} {
	reverse_proxy 127.0.0.1:8787 {
		header_up X-Clausid-Client-IP {http.request.remote.host}
	}
}

# For Cloudflare Tunnel, use this dedicated loopback site instead.
# Point cloudflared at http://127.0.0.1:8790 on the same host.
